  "author": "dax",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "relevance",
    "jev"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DAXZEIT/Pi-JEV-VCC-memory-relevance.git"
  },
  "bugs": "https://github.com/DAXZEIT/Pi-JEV-VCC-memory-relevance/issues",
  "homepage": "https://github.com/DAXZEIT/Pi-JEV-VCC-memory-relevance#readme",
  "files": [
    "jev-relevance.ts",
    "jev",
    "scripts",
    "docs",
    "examples"
  ],
  "pi": {
    "extensions": [
      "./jev-relevance.ts"
    ],
    "skills": [
      "./jev"
    ],
    "image": "docs/hero.png"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
